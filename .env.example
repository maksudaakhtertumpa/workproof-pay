# Copy this file to .env and fill in your keys. Never commit .env to GitHub.

# PayPal Developer Dashboard -> Apps & Credentials (Sandbox) -> your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
# Time zone of your PayPal seller account (invoice dates use it, so invoices are SENT, not SCHEDULED).
SELLER_TIMEZONE=America/Los_Angeles

# Google AI Studio -> Get API key (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used automatically when the main model is busy (503) or unavailable.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional: GitHub personal access token (no scopes needed for public repos).
# Raises the GitHub limit and lets the AI see lines changed per commit.
GITHUB_TOKEN=

# Form defaults for the demo. Use your US sandbox buyer email as the client.
DEFAULT_CLIENT_NAME=Acme Ltd
DEFAULT_CLIENT_EMAIL=
DEFAULT_CURRENCY=USD
DEFAULT_HOURLY_RATE=40

# Guardrails
MAX_INVOICE_TOTAL=5000
AI_REQUESTS_PER_HOUR=60
